* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    line-height: 1.6;
    background-color: #f4f4f9;
    color: #333;
}

main {
    padding: 20px;
    max-width: 1200px;
    margin: 0 auto;
}

section {
    background: #fff;
    margin-bottom: 30px;
    padding: 20px;
    border-radius: 8px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

h2 {
    margin-bottom: 15px;
    color: #444;
}

header {
    background-color: #333;
    color: #fff;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 30px;
}

.menu-open, .menu-close {
    display: none; 
    font-size: 24px;
    color: #fff;
    text-decoration: none;
}

nav ul {
    display: flex;
    list-style: none;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
    padding: 5px 15px;
}

footer {
    background-color: #333;
    color: #fff;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

footer .footer-links a {
    color: #fff;
    text-decoration: none;
    margin-right: 15px;
}

.column-text {
    column-count: 3;
    column-gap: 30px;
    column-rule: 1px solid #ddd;
}

.flex-container {
    display: flex;
    justify-content: space-between;
    gap: 20px;
}

.flex-item {
    flex: 1;
    background: #e2e8f0;
    padding: 20px;
    border-radius: 5px;
}

.grid-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.grid-item {
    background: #cbd5e1;
    padding: 30px;
    text-align: center;
    font-weight: bold;
    border-radius: 5px;
}

@media (max-width: 500px) {
    
    .column-text {
        column-count: 1;
    }

    .flex-container {
        flex-direction: column;
    }

    .grid-container {
        grid-template-columns: repeat(2, 1fr);
    }

    footer {
        flex-direction: column;
        gap: 15px;
        text-align: center;
    }

    footer .footer-links {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    
    .menu-open {
        display: block;
    }

    nav {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(51, 51, 51, 0.95);
        z-index: 1000;
        justify-content: center;
        align-items: center;
    }

    nav ul {
        flex-direction: column;
        align-items: center;
        gap: 25px;
    }

    nav ul li a {
        font-size: 24px;
    }

    .menu-close {
        display: block;
        position: absolute;
        top: 15px;
        right: 30px;
        font-size: 40px;
    }

    nav:target {
        display: flex;
    }
}
